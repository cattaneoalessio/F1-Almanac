# Copia questo file in .env (stessa cartella) e valorizza le variabili
# per far girare il backend in locale. Su Render, le stesse variabili
# vanno impostate in Environment Variables (dashboard del servizio),
# non in questo file.

# Connection string di Neon (vedi guida-deployment.md, punto 1.2)
DATABASE_URL=postgresql://utente:password@host/nome_db

# Base URL dell'endpoint Netlify Identity del sito, SENZA /user finale
# (lo aggiunge auth.py). Serve per verificare i token di login quando il
# frontend chiama POST /arcade/punteggi — senza questa variabile il
# backend funziona comunque, semplicemente nessun punteggio Arcade verrà
# mai salvato (login sempre facoltativo in questo progetto).
NETLIFY_IDENTITY_URL=https://il-tuo-sito.netlify.app/.netlify/identity

# Chiave condivisa per POST /game/close-gp/{slug} (assegna i punti del
# Campionato Mondiale Virtuale): senza questa variabile l'endpoint rifiuta
# sempre (403), per design — non c'è ancora un sistema di ruoli in questo
# progetto, quindi questo è il minimo per evitare che chiunque possa
# chiudere un GP a piacere. Genera un valore lungo e casuale, es. con
# `openssl rand -hex 24`, e passalo come header X-Admin-Key quando chiami
# l'endpoint (a mano, per ora — non c'è ancora un pannello admin).
GAME_ADMIN_KEY=

# Non letta dall'app (nessun os.environ.get per questa): è una variabile
# d'ambiente di RENDER, non nostra — gli dice quale versione di Python
# usare per il servizio invece di lasciargli scegliere il "default" del
# momento (che può cambiare senza preavviso, vedi .python-version nella
# stessa cartella per la stessa cosa documentata anche nel repo). Va
# impostata SOLO su Render (Environment Variables), non serve in locale:
# lì usi comunque l'interprete Python che hai già installato tu.
# PYTHON_VERSION=3.12.3
