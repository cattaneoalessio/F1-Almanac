# Copia questo file in .env (stessa cartella) e valorizza le variabili
# per far girare il backend in locale. Su Render, le stesse variabili
# vanno impostate in Environment Variables (dashboard del servizio),
# non in questo file.

# Connection string di Neon (vedi guida-deployment.md, punto 1.2)
DATABASE_URL=postgresql://utente:password@host/nome_db

# Base URL dell'endpoint Netlify Identity del sito, SENZA /user finale
# (lo aggiunge auth.py). Serve per verificare i token di login quando il
# frontend chiama POST /arcade/punteggi — senza questa variabile il
# backend funziona comunque, semplicemente nessun punteggio Arcade verrà
# mai salvato (login sempre facoltativo in questo progetto).
NETLIFY_IDENTITY_URL=https://il-tuo-sito.netlify.app/.netlify/identity
